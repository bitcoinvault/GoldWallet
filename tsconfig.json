{
  "compilerOptions": {
    "target": "ES2019",
    "module": "CommonJS",
    "jsx": "react-native",
    "noEmit": true,
    "allowJs": true,
    "strict": true,
    "suppressImplicitAnyIndexErrors": true,
    "ignoreDeprecations": "5.0",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "isolatedModules": false,
    "esModuleInterop": true,
    "lib": ["esnext"],
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "baseUrl": "./src",
    "skipLibCheck": true,
    "paths": {
      "app/*": ["./*"]
    }
  },
  "exclude": [
    "node_modules",
    "babel.config.js",
    "jest.config.js",
    "scripts",
    "sourcemap.ios.js",
    "sourcemap.android.js"
  ]
}
