# Resolve React Native's CocoaPods helpers through Node so hoisted installs use
# the same package instance as the JavaScript toolchain.
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

require_relative '../node_modules/react-native-permissions/scripts/setup'

platform :ios, min_ios_version_supported
prepare_react_native_project!

# RN Firebase 26.1 enables SPM automatically on RN >= 0.75. Keep the current
# CocoaPods dependency path until the SPM archive flow is validated on macOS.
$RNFirebaseDisableSPM = true

setup_permissions([
  'Camera',
])

react_native_path = File.dirname(
  Pod::Executable.execute_command('node', ['-p',
    'require.resolve("react-native/package.json", {paths: [process.argv[1]]})', __dir__]).strip
)

def configure_goldwallet_target
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :hermes_enabled => true
  )
end

target 'GoldWallet' do
  configure_goldwallet_target
end

target 'GoldWallet Beta' do
  configure_goldwallet_target
end

target 'GoldWallet Stage' do
  configure_goldwallet_target
end

target 'GoldWallet Dev' do
  configure_goldwallet_target
end

post_install do |installer|
  react_native_post_install(
    installer,
    react_native_path,
    :mac_catalyst_enabled => false
  )
end
